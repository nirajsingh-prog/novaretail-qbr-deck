# Copy this file to .env and fill ONE of the two options.

# Option A - Gemini API key
GOOGLE_API_KEY=

# Option B - Vertex AI (e.g. the training GCP project)
# GOOGLE_GENAI_USE_VERTEXAI=TRUE
# GOOGLE_CLOUD_PROJECT=your-project-id
# GOOGLE_CLOUD_LOCATION=us-central1

# Optional
# DECK_AGENT_MODEL=gemini-2.5-flash
# DECK_SESSION_DB=sqlite+aiosqlite:///deck_sessions.db   # persist sessions + preferences (pip install aiosqlite)
